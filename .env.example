# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173

# Database (Prisma / PostgreSQL)
DATABASE_URL=postgresql://yws:yws_dev_password@localhost:5433/yws_dev?schema=public

# Redis (cache, throttling, BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# JWT
JWT_SECRET=change_me_access_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# 2FA
TOTP_ISSUER=YWS

# Symmetric key used to encrypt tenant payment credentials / bot tokens at rest
ENCRYPTION_KEY=change_me_32_byte_minimum_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Mail (BullMQ email processor)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com
