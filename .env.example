# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# required, no default, once NODE_ENV=production — see validate-env.ts.
# Comma-separated allowlist; an unset/empty value in production means any
# origin is allowed with credentials.
CORS_ORIGINS=http://localhost:5173

# Database (Prisma / PostgreSQL)
DATABASE_URL=postgresql://yws:yws_dev_password@localhost:5433/yws_dev?schema=public

# Redis (cache, throttling, BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# Global per-IP rate limit (ThrottlerGuard, applies to every route unless
# overridden). Defaults match previous hardcoded values — override only if
# you've measured real traffic needs a different ceiling.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# JWT — required, no default. The app refuses to boot without it (see
# src/config/validate-env.ts) rather than silently sign tokens with `undefined`.
JWT_SECRET=change_me_access_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# 2FA
TOTP_ISSUER=YWS

# Symmetric key used to encrypt tenant payment credentials / bot tokens at
# rest. Required, no default — losing or never setting it used to silently
# fall back to a literal hardcoded in source, decryptable by anyone with DB
# read access. Now the app refuses to boot without it (validate-env.ts).
ENCRYPTION_KEY=change_me_32_byte_minimum_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# MercadoPago (platform account; used for webhook verification and payment
# lookups only — per-tenant checkout credentials are stored encrypted in the DB)
MERCADOPAGO_ACCESS_TOKEN=TEST-xxx
MERCADOPAGO_WEBHOOK_SECRET=xxx

# Mail (BullMQ email processor)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com

# Platform SUPER_ADMIN seed account (created by `npm run prisma:seed`)
SUPER_ADMIN_EMAIL=superadmin@yws.dev
SUPER_ADMIN_PASSWORD=SuperAdmin123!

# Customer (storefront) JWT — separate secrets from staff JWT above.
# Required, no default — same boot-time check as JWT_SECRET.
JWT_CUSTOMER_SECRET=change_me_customer_access_secret
JWT_CUSTOMER_EXPIRES_IN=15m
JWT_CUSTOMER_REFRESH_SECRET=change_me_customer_refresh_secret
JWT_CUSTOMER_REFRESH_EXPIRES_IN=30d

# Off-box Postgres backups (BackupsService). Left unset (any of the vars
# below missing), backups are simply disabled — nothing fails, the app just
# logs a warning once at boot and skips the scheduled job. Any S3-compatible
# provider works; example values below are for Cloudflare R2.
#
# BACKUP_DATABASE_URL is NOT the same role as DATABASE_URL above — see
# DEPLOY.md for why (FORCE ROW LEVEL SECURITY blocks pg_dump for any role
# without BYPASSRLS, and that attribute must never go on the app's own
# runtime role) and the exact one-time SQL to create it.
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_COUNT=14
BACKUP_DATABASE_URL=postgresql://yws_backup:change_me@localhost:5433/yws_dev
BACKUP_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=yws-backups
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=postgres

# Take-rate (%) used for the platform dashboard's commission estimate on any
# tenant without its own override (Tenant.commissionRate).
PLATFORM_DEFAULT_COMMISSION_RATE=5
