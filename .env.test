# DATABASE_URL below is a placeholder for a native Postgres on the default
# port (matches CI's service container). test/setup-env.ts overwrites it at
# test-boot time with TEST_DATABASE_URL if that's set, so it's what actually
# wins in this repo's local docker-compose setup (Postgres on :5433) — see
# README.md's "Local setup (this repo's docker-compose)" for the exact value,
# or just run `npm run test:e2e:local`.
NODE_ENV=test
DATABASE_URL=postgresql://yws_test:yws_test@localhost:5432/yws_test?schema=public
JWT_SECRET=test_access_secret_at_least_32_bytes_long
JWT_REFRESH_SECRET=test_refresh_secret_at_least_32_bytes
ENCRYPTION_KEY=test_encryption_key_32_bytes_min
CORS_ORIGINS=http://localhost:5173
API_PREFIX=api/v1
STRIPE_SECRET_KEY=sk_test_e2e_placeholder_not_a_real_key
REDIS_HOST=localhost
REDIS_PORT=6379

JWT_CUSTOMER_SECRET=test_customer_access_secret_at_least_32b
JWT_CUSTOMER_REFRESH_SECRET=test_customer_refresh_secret_at_least_32b
